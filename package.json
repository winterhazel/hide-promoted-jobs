{
  "name": "hide-promoted-jobs",
  "version": "1.6.0",
  "description": "Hides promoted job postings on LinkedIn's job search pages.",
  "main": "index.js",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "web-ext build -s ext --overwrite-dest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "npm run check && npm run release:build",
    "release:build": "node scripts/build-release.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhazel/hide-promoted-jobs.git"
  },
  "author": "Fabricio Duarte",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/winterhazel/hide-promoted-jobs/issues"
  },
  "homepage": "https://github.com/winterhazel/hide-promoted-jobs#readme",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "linkedom": "^0.18.12",
    "prettier": "^2.8.8",
    "web-ext": "^10.4.0"
  }
}
